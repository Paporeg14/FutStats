{
  "name": "futstats",
  "version": "1.0.0",
  "description": "App de análisis y estadísticas de fútbol en tiempo real",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "next build",
    "client": "cd client && npm run dev",
    "both": "concurrently \"npm run dev\" \"npm run client\"",
    "lint": "eslint .",
    "test": "jest"
  },
  "keywords": [
    "football",
    "statistics",
    "analytics",
    "real-time",
    "sports"
  ],
  "author": "Paporeg14",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "express-rate-limit": "^7.0.0",
    "mongoose": "^8.0.0",
    "redis": "^4.6.11",
    "ws": "^8.14.2",
    "node-cron": "^3.0.2",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "joi": "^17.11.0",
    "nodemon": "^3.0.2"
  },
  "devDependencies": {
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "concurrently": "^8.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
